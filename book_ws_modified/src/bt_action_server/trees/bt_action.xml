<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="bt_action">
    <Sequence>
      <WaitForServer server_name="reach_location"/>

      <!-- Waypoint 1: home / ready pose. -->
      <CallAction server_name="reach_location"
                  x="0.265" y="-0.065" z="0.980"
                  qx="0.500" qy="-0.500" qz="0.500" qw="0.500"
                  timeout="15"/>

      <!-- Waypoint 2: pick pose above the table. -->
      <CallAction server_name="reach_location"
                  x="0.138" y="-0.215" z="1.038"
                  qx="0.037" qy="0.996" qz="-0.078" qw="0.039"
                  timeout="15"/>

      <!-- Waypoint 3: drop / second sort position. -->
      <CallAction server_name="reach_location"
                  x="-0.143" y="-0.444" z="1.004"
                  qx="1.000" qy="0.000" qz="0.003" qw="0.004"
                  timeout="15"/>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="CallAction" editable="true">
      <input_port name="server_name"/>
      <input_port name="x"/>
      <input_port name="y"/>
      <input_port name="z"/>
      <input_port name="qx"/>
      <input_port name="qy"/>
      <input_port name="qz"/>
      <input_port name="qw"/>
      <input_port name="timeout"/>
    </Action>
    <Action ID="WaitForServer" editable="true">
      <input_port name="server_name"/>
    </Action>
  </TreeNodesModel>
</root>
