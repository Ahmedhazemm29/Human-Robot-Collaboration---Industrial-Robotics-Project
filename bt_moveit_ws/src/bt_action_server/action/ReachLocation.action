# Goal
float32 x
float32 y
float32 z
float32 qx
float32 qy
float32 qz
float32 qw
float32 timeout
# When true, plan a straight-line Cartesian move (Pilz LIN) to this pose
# instead of the default point-to-point (PTP) joint move. Defaults to false.
bool cartesian false
---
# Result
bool success
string message
---
# Feedback
float32 current_x
float32 current_y
