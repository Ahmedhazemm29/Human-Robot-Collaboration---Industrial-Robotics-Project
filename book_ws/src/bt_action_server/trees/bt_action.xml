<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="bt_action">
    <Sequence>
      <WaitForServer server_name="reach_location"/>
      <CallAction server_name="reach_location"
                  x="0.100"
                  y="0.133"
                  timeout="15"/>
      <CallAction server_name="reach_location"
                  x="0.0"
                  y="0.0"
                  timeout="15"/>
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <Action ID="CallAction" editable="true">
      <input_port name="server_name"/>
      <input_port name="x"/>
      <input_port name="y"/>
      <input_port name="timeout"/>
    </Action>
    <Action ID="WaitForServer" editable="true">
      <input_port name="server_name"/>
    </Action>
  </TreeNodesModel>
</root>
