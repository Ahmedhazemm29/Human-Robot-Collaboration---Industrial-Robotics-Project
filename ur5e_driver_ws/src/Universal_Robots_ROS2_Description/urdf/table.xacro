<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="table" params="parent prefix *origin">

    <link name="${prefix}table">
      <visual>
        <origin xyz="0 0 0.375"/>
        <geometry>
          <box size="1.4 0.71 0.71"/>
        </geometry>
        <material name="white">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0.375"/>
        <geometry>
          <box size="1.45 0.75 0.75"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}table_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${prefix}table" />
      <origin xyz="0 0 0.7" rpy="${pi} 0 ${pi/2}"/>
    </joint>
  </xacro:macro>

</robot>
